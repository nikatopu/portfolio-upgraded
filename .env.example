# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Everything is optional locally: without DATABASE_URL the wall shows sample notes and the forms say
# "not available"; without Turnstile keys the captcha is skipped.
# For a real local database, use a Neon *development branch* URL here (never the production one).
# In production, missing keys fail closed (forms show "not available right now" instead of
# silently accepting spam).

# --- Database: Neon Postgres (Vercel → Storage / Marketplace → Neon; sets this automatically) ---
DATABASE_URL=

# --- Security ---
# 32+ random characters. Signs the admin session cookie and salts IP hashes.
# Generate one with: openssl rand -base64 48
APP_SECRET=
# Password for /admin (10+ characters)
ADMIN_PASSWORD=

# --- Spam protection: Cloudflare Turnstile (dash.cloudflare.com → Turnstile → add site nikatopu.dev) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


